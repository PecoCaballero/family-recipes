{
  "name": "shared",
  "projectType": "library",
  "sourceRoot": "libs/shared/src",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/shared/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config libs/shared/jest.config.cjs"
      }
    }
  }
}
