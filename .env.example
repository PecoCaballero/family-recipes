# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_recipes"
# Production (hosted Postgres, e.g. Neon pooled endpoint) requires TLS:
#   postgresql://user:pass@host:5432/db?sslmode=require
# The API enables TLS only when `sslmode=require` is present.

# JWT
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Sign-In
# The Google OAuth web client ID used by the API to verify ID token audience.
# Same value as the web client ID registered in Google Cloud Console.
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
# The Google OAuth client ID exposed to the browser for Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"

# AI recipe import (OpenAI chat-completions)
# Required. Server-side only; never exposed to the browser.
AI_API_KEY=""
# Optional. Defaults shown. Swap to any OpenAI-compatible endpoint.
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_MODEL="gpt-4o-mini"

# CORS (API)
# In production, restrict the browser origin that may call the API.
# Leave unset in development to reflect any origin.
CORS_ORIGIN="https://<web-app>.vercel.app"

# API base URL (web)
# The public URL of the deployed API; inlined into the frontend bundle.
NEXT_PUBLIC_API_BASE_URL="https://<api>.up.railway.app"

# Avatar storage
# `local` writes to the filesystem (dev/test). `s3` uses an S3-compatible store.
STORAGE_PROVIDER="local"
# Required when STORAGE_PROVIDER=s3 (e.g. Cloudflare R2).
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL="https://<cdn-or-r2-public>"
