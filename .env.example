# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_recipes"

# JWT
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Sign-In
# The Google OAuth web client ID used by the API to verify ID token audience.
# Same value as the web client ID registered in Google Cloud Console.
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
# The Google OAuth client ID exposed to the browser for Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"

# AI recipe import (OpenAI chat-completions)
# Required. Server-side only; never exposed to the browser.
AI_API_KEY=""
# Optional. Defaults shown. Swap to any OpenAI-compatible endpoint.
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_MODEL="gpt-4o-mini"
